APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rmmh
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_ANALYTICS_ID=

IPINFO_TOKEN=

# --- Booking engine -----------------------------------------------------------
# static = placeholder availability, nothing is booked and no patient data is
# stored. athena = live athenahealth scheduling.
BOOKING_DRIVER=static

# TESTING ONLY: skip athena document uploads (consent/insurance/ID) and treat
# them as successful, so the intake flow can be exercised. Never enable in production.
BOOKING_FAKE_UPLOADS=false

# Athena admin-document subclasses (ADMINSUBCLASS enum) for uploaded documents.
# Must be values enabled in the practice's athenaOne document configuration.
ATHENA_SUBCLASS_CONSENT=CONSENT
ATHENA_SUBCLASS_INSURANCE=INSURANCECARD

# Which athena environment every call goes to. Test everything on preview
# first; promoting is this one line, because the IDs below are held separately
# for each environment.
ATHENA_ENV=preview

# Seconds. Reads are retried on a 5xx but never on a timeout; writes are never
# retried at all, so they get longer.
ATHENA_TIMEOUT=25
ATHENA_WRITE_TIMEOUT=45

# --- athena: PREVIEW (sandbox) ---
# Safe to experiment against. Credentials come from the athenahealth developer
# portal; the preview practice is a shared sandbox, not RMMH.
ATHENA_PREVIEW_CLIENT_ID=
ATHENA_PREVIEW_CLIENT_SECRET=
ATHENA_PREVIEW_PRACTICE_ID=195900

# Fill these from: php artisan athena:discover
ATHENA_PREVIEW_DEPARTMENT_ID=
ATHENA_PREVIEW_PROVIDER_ID_TIFFANY=
ATHENA_PREVIEW_REASON_INPERSON_NEW=
ATHENA_PREVIEW_REASON_INPERSON_ESTABLISHED=
ATHENA_PREVIEW_REASON_TELEHEALTH_NEW=
ATHENA_PREVIEW_REASON_TELEHEALTH_ESTABLISHED=
ATHENA_PREVIEW_REASON_KETAMINE_NEW=
ATHENA_PREVIEW_REASON_KETAMINE_ESTABLISHED=

# --- athena: PRODUCTION (live practice — real patients) ---
# Leave blank until preview is fully working. Practice 24211 is RMMH.
ATHENA_PRODUCTION_CLIENT_ID=
ATHENA_PRODUCTION_CLIENT_SECRET=
ATHENA_PRODUCTION_PRACTICE_ID=24211

ATHENA_PRODUCTION_DEPARTMENT_ID=
ATHENA_PRODUCTION_PROVIDER_ID_TIFFANY=
ATHENA_PRODUCTION_REASON_INPERSON_NEW=
ATHENA_PRODUCTION_REASON_INPERSON_ESTABLISHED=
ATHENA_PRODUCTION_REASON_TELEHEALTH_NEW=
ATHENA_PRODUCTION_REASON_TELEHEALTH_ESTABLISHED=
ATHENA_PRODUCTION_REASON_KETAMINE_NEW=
ATHENA_PRODUCTION_REASON_KETAMINE_ESTABLISHED=
